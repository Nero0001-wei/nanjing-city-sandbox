 <node id="13287554385" visible="true" version="1" changeset="174341546" timestamp="2025-11-07T16:08:55Z" user="Higashimado" uid="23239738" lat="32.0903595" lon="118.7419625">
  <tag k="historic" v="memorial"/>
  <tag k="inscription" v="挹江门附近是侵华日军南京大屠杀中我遇难同胞尸骨丛葬地之一。从一九三七年十二月至一九三八年五月，南京崇善堂红卍字会等慈善团体先后六批，共收死难者遗骸五千一百多具，埋葬于挹江门东城根及其附近之姜家园石榴园等地，特立此碑，以志其事，兼励后人牢记历史，振兴中华。"/>
  <tag k="memorial" v="war_memorial"/>
  <tag k="name" v="挹江门丛葬地纪念碑"/>
  <tag k="name:en" v="Yijiangmen Mass Grave Memorial"/>
  <tag k="name:zh" v="挹江门丛葬地纪念碑"/>
  <tag k="start_date" v="1985-08-15"/>
 </node>
 <node id="13287554386" visible="true" version="1" changeset="174341546" timestamp="2025-11-07T16:08:55Z" user="Higashimado" uid="23239738" lat="32.1044794" lon="118.7412242">
  <tag k="historic" v="memorial"/>
  <tag k="memorial" v="war_memorial"/>
  <tag k="name" v="煤炭港遇难同胞纪念碑"/>
  <tag k="name:en" v="=Memorial to the Fallen Compatriots in Meitangang"/>
  <tag k="name:zh" v="煤炭港遇难同胞纪念碑"/>
  <tag k="start_date" v="1985-08-15"/>
 </node>
 <node id="13287554387" visible="true" version="2" changeset="174342779" timestamp="2025-11-07T16:36:30Z" user="Higashimado" uid="23239738" lat="32.1194384" lon="118.7589549">
  <tag k="historic" v="memorial"/>
  <tag k="inscription" v="一九三七年十二月十五日夜，侵华日军将被其搜捕之我市平民和已解除武装之守城官兵九千余人，押至鱼雷营，以机枪集体射杀。同月，日军又在鱼雷营、宝塔桥一带再次杀害我军民三万余人。死难者之遗骸，直至次年二月，犹曝露于军营码头等地，惨不可睹。后由红卍字会就地掩埋，仅二月十九日、二十一日、二十二日三天，埋尸即达五千余具。惨史难忘，忆往志慨，特立此碑，正告方来。"/>
  <tag k="memorial" v="war_memorial"/>
  <tag k="name" v="鱼雷营遇难同胞纪念碑"/>
  <tag k="name:en" v="Memorial to the Fallen Compatriots in Yuleiying"/>
  <tag k="name:zh" v="鱼雷营遇难同胞纪念碑"/>
 </node>
