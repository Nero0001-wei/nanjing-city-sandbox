 <node id="13287565925" visible="true" version="2" changeset="174342656" timestamp="2025-11-07T16:33:45Z" user="Higashimado" uid="23239738" lat="32.0604734" lon="118.7856681">
  <tag k="historic" v="memorial"/>
  <tag k="inscription" v="一九三七年十二月，侵华日军屠杀我南京同胞达三十万众。仅此北极阁毗近处，惨遭杀害者即达两千余人。其时，鼓楼至大石桥，北门桥至唱经楼，太平门，富贵山及蓝家庄等地，伏尸残骸，盈街塞道，涂膏凝血，触目生哀。翌年一、二月间，罹难同胞之遗骸经南京崇善堂收殓，丛葬于此山之麓及近山之城根等处。爰立此碑，永志不忘，藉勉后人，奋发图强，振兴中华，国运其昌。"/>
  <tag k="memorial" v="war_memorial"/>
  <tag k="name" v="北极阁附近遇难同胞纪念碑"/>
  <tag k="name:en" v="Memorial to the Fallen Compatriots in Beijige"/>
  <tag k="name:zh" v="北极阁附近遇难同胞纪念碑"/>
  <tag k="start_date" v="1985-08-15"/>
 </node>
