 <node id="13287565939" visible="true" version="1" changeset="174341546" timestamp="2025-11-07T16:08:55Z" user="Higashimado" uid="23239738" lat="32.0588822" lon="118.7548152"/>
 <node id="13287565940" visible="true" version="1" changeset="174341546" timestamp="2025-11-07T16:08:55Z" user="Higashimado" uid="23239738" lat="32.0588447" lon="118.7547770">
  <tag k="historic" v="memorial"/>
  <tag k="inscription" v="937年12月，侵华日军制造了震撼中外的南京大屠杀事件，我数以千计的无辜同胞在本院境内，即清凉山附近之原吴家港、韩家桥等地遇难。为纪念死者，激励后人，振兴中华，维护和平特立此碑。"/>
  <tag k="memorial" v="war_memorial"/>
  <tag k="name" v="清凉山遇难同胞纪念碑"/>
  <tag k="name:en" v="Memorial to Jinling University Refugee Shelter and the Perished Compatriots"/>
  <tag k="name:zh" v="清凉山遇难同胞纪念碑"/>
  <tag k="start_date" v="1985-08-15"/>
 </node>
