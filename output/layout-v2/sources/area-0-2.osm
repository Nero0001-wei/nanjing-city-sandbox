  <nd ref="9931216495"/>
  <nd ref="9931216486"/>
  <tag k="description" v="本地块所在的中央商务区面积约7.6平方公里，规划以小尺度街区打造舒适宜人、高效便捷的城市空间，结合周边片区，融合新金融、商业商务、文化休闲和生态宜居等多种功能，成为引领南京江北新区发展的活力聚集区和多功能示范区。 本地块位于中央商务区中部，位于浦镇大街、浦滨路轴线交汇处，北侧紧邻国际健康城片区，西侧紧邻一批次成功出让的NO.新区2022G03地块，楼面地价25169元/㎡，毛坯销售限价40000元/㎡，南侧晴翠府将配建13万平方米商业综合体，未来将享有十分完善的医疗、康养、商业配套资源。"/>
  <tag k="landuse" v="greenfield"/>
  <tag k="name" v="二类居住用地"/>
 </way>
 <way id="1083719721" visible="true" version="5" changeset="179567847" timestamp="2026-03-09T08:17:34Z" user="明月绕船" uid="12456632">
  <nd ref="9931216496"/>
  <nd ref="9931216497"/>
  <nd ref="9931216498"/>
  <nd ref="9931216499"/>
  <nd ref="9931216500"/>
