  <nd ref="13287565948"/>
  <nd ref="13287565945"/>
  <tag k="description" v="1930年代时丛葬地所在地为中央陆军监狱，日军占领南京后，一批国军战俘被关押在陆军监狱中。1937年12月15日下午，日军在监狱及周边地区将这批战俘以及一些民众杀害。1985年为修建纪念馆，此处经过勘探后发掘出一座万人坑。"/>
  <tag k="historic" v="grave"/>
  <tag k="name" v="江东门丛葬地"/>
  <tag k="name:en" v="Jiangdongmen Mass Grave"/>
