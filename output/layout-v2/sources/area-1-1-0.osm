  <tag k="description" v="1937年12月15日下午1时许，2000余名中国军警及百姓被日军带至汉中门外，日军以百余人为一组，共分成约16组进行射杀，射杀后未即死者又遭刺刀刺死，日军最后焚尸灭迹"/>
  <tag k="historic" v="grave"/>
  <tag k="name" v="汉中门丛葬地"/>
  <tag k="name:en" v="Hanzhongmen Mass Grave"/>
  <tag k="name:zh" v="汉中门丛葬地"/>
 </way>
